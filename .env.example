# Modelo das variáveis de ambiente. Os valores reais ficam só na Vercel
# (Settings → Environment Variables) ou num arquivo .env local, que o Git ignora.

# Obrigatória para a leitura do rótulo por foto
ANTHROPIC_API_KEY=

# Senha da página admin.html (consulta das leituras). Use 16 caracteres ou mais.
ADMIN_TOKEN=

# Criadas sozinhas pela Vercel ao conectar um Blob privado ao projeto (não preencher à mão)
# BLOB_STORE_ID=

# Opcionais
CLAUDE_MODEL=claude-haiku-5-5
LIMITE_FOTOS_HORA=20
